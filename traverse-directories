#!/bin/bash
#
# Interactive directory navigation using fzf
# Press Escape to exit

while true; do
    # Get list of directories in current location
    # Use find to properly handle directories, then format for display
    mapfile -t dirs < <(find . -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)

    # Add home directory
    dirs=("~ (home directory)" "${dirs[@]}")

    # Add parent directory option if not at root
    if [[ "$PWD" != "/" ]]; then
        dirs=(".. (parent directory)" "${dirs[@]}")
    fi

    # Show current location and let user select directory
    # --expect captures the key pressed (alt-enter in this case)
    result=$(printf '%s\n' "${dirs[@]}" | fzf \
        --height=40% \
        --reverse \
        --border \
        --prompt="Navigate ($PWD) > " \
        --header="Select directory (ESC to quit, ALT+ENTER to select current)" \
        --expect=alt-enter \
        --preview="[[ -d {} ]] && ls -lah {} 2>/dev/null || ls -lah '..' 2>/dev/null" \
        --preview-window=right:50%)

    # First line is the key pressed, second line is the selection
    key=$(echo "$result" | head -n1)
    selected=$(echo "$result" | tail -n1)

    # Check if user cancelled (pressed Escape or Ctrl+C)
    if [[ -z "$result" ]]; then
        echo "$PWD"
        break
    fi

    # Check if user pressed shift-enter to select current directory
    if [[ "$key" == "alt-enter" ]]; then
        echo "$PWD"
        break
    fi

    # Change to selected directory
    if [[ "$selected" == ".. (parent directory)" ]]; then
        cd ..
    elif [[ "$selected" == "~ (home directory)" ]]; then
        cd "$HOME"
    else
        # Change to selected directory
        if cd "$selected" 2>/dev/null; then
            :  # Successfully changed directory
        else
            echo "Error: Could not access directory '$selected'"
            read -rp "Press Enter to continue..."
        fi
    fi
done
